+                 impl->repair_sync_policy_full_frames,
+                 impl->repair_sync_fallbacks,
+                 impl->repair_sync_planner_steps);
+    }
+    impl->repair_sync_log_window_us = now_us;
+    impl->repair_sync_range_bytes = 0;
+    impl->repair_sync_range_calls = 0;
+    impl->repair_sync_full_bytes = 0;
+    impl->repair_sync_full_calls = 0;
+    impl->repair_sync_policy_full_frames = 0;
+    impl->repair_sync_fallbacks = 0;
+    impl->repair_sync_planner_steps = 0;
+}
