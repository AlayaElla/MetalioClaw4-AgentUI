+static void repair_sync_record_full_frame(
+    esp_lv_adapter_display_bridge_v9_t *impl)
+{
+    if (impl->disp_fb == NULL || impl->runtime.frame_buffer_size == 0) {
+        return;
+    }
+    display_cache_msync_framebuffer(impl->disp_fb,
+                                    impl->runtime.frame_buffer_size);
+    impl->repair_sync_full_bytes += impl->runtime.frame_buffer_size;
+    impl->repair_sync_full_calls++;
+}
+
+static bool repair_rect_plan_get(const void *source,
+                                size_t index,
+                                display_cache_sync_rect_t *rect)
+{
+    if (source == NULL || rect == NULL) {
+        return false;
+    }
+    const lv_area_t *areas = (const lv_area_t *)source;
+    rect->x1 = areas[index].x1;
+    rect->y1 = areas[index].y1;
+    rect->x2 = areas[index].x2;
+    rect->y2 = areas[index].y2;
+    return true;
+}
+
+static display_cache_sync_plan_result_t repair_sync_front_ranges(
+    esp_lv_adapter_display_bridge_v9_t *impl,
+    const lv_area_t *repair,
+    uint16_t repair_count,
+    uint16_t hor_res,
+    uint16_t ver_res,
+    uint8_t color_bytes)
+{
+    const uintptr_t framebuffer = (uintptr_t)impl->disp_fb;
+    const size_t frame_capacity = impl->runtime.frame_buffer_size;
+    const size_t cache_line_size =
+        display_bridge_get_cache_line_size_by_addr(impl->disp_fb);
+    size_t planned_bytes = 0;
+    size_t planned_calls = 0;
+    size_t planner_steps = 0;
+    display_cache_sync_iterator_t iterator;
+    const display_cache_sync_plan_result_t plan =
+        display_cache_sync_choose_plan(
+            framebuffer, frame_capacity, hor_res, ver_res, color_bytes,
+            cache_line_size, repair, repair_count, repair_rect_plan_get,
+            &planned_bytes, &planned_calls, &planner_steps, &iterator);
+    impl->repair_sync_planner_steps += planner_steps;
+    if (plan == DISPLAY_CACHE_SYNC_PLAN_INVALID) {
+        return plan;
+    }
+    if (plan == DISPLAY_CACHE_SYNC_PLAN_FULL_FRAME) {
+        repair_sync_record_full_frame(impl);
+        impl->repair_sync_policy_full_frames++;
+        return plan;
+    }
+
+    size_t actual_bytes = 0;
+    size_t actual_calls = 0;
+    display_cache_sync_range_t range = {0};
+    while (display_cache_sync_iterator_next(&iterator, &range)) {
+        const esp_err_t err = esp_cache_msync(
+            (void *)range.address, range.size, ESP_CACHE_MSYNC_FLAG_DIR_C2M);
+        if (err != ESP_OK) {
+            return DISPLAY_CACHE_SYNC_PLAN_INVALID;
+        }
+        impl->repair_sync_range_bytes += range.size;
+        impl->repair_sync_range_calls++;
+        actual_bytes += range.size;
+        actual_calls++;
+    }
+    if (iterator.failed || iterator.planner_steps != planner_steps ||
+        actual_bytes != planned_bytes || actual_calls != planned_calls) {
+        return DISPLAY_CACHE_SYNC_PLAN_INVALID;
+    }
+    return plan;
+}
