diff --git a/host/drivers/transport/sdio/sdio_standby_gate.h b/host/drivers/transport/sdio/sdio_standby_gate.h
new file mode 100644
--- /dev/null
+++ b/host/drivers/transport/sdio/sdio_standby_gate.h
@@ -0,0 +1,63 @@
+/* Metalio offline standby: park workers only at buffer/lock-free boundaries. */
+#pragma once
+#include "freertos/FreeRTOS.h"
+#include "freertos/event_groups.h"
+#include "freertos/semphr.h"
+#include "freertos/task.h"
+#include "driver/gpio.h"
+
+enum {
+    SDIO_WORKER_READ = BIT0,
+    SDIO_WORKER_TX = BIT1,
+    SDIO_WORKER_COPY = BIT2,
+    SDIO_WORKER_RX = BIT3,
+    SDIO_WORKERS_ALL = BIT0 | BIT1 | BIT2 | BIT3,
+    SDIO_ACK_SHIFT = 4,
+};
+static StaticEventGroup_t sdio_standby_events_storage;
+static EventGroupHandle_t sdio_standby_events;
+static StaticSemaphore_t sdio_standby_tx_mutex_storage;
+static SemaphoreHandle_t sdio_standby_tx_mutex;
+static bool sdio_standby_accept_tx = true; // protected by tx_mutex
+static bool sdio_coprocessor_off;
+static bool sdio_coprocessor_starting;
+static bool sdio_coprocessor_boot_started;
+static TickType_t sdio_coprocessor_boot_tick;
+
+static void sdio_standby_gate_init(void)
+{
+    sdio_standby_events = xEventGroupCreateStatic(&sdio_standby_events_storage);
+    sdio_standby_tx_mutex = xSemaphoreCreateMutexStatic(&sdio_standby_tx_mutex_storage);
+    xEventGroupSetBits(sdio_standby_events, SDIO_WORKERS_ALL);
+}
+
+static void sdio_standby_checkpoint(EventBits_t worker)
+{
+    while (!(xEventGroupGetBits(sdio_standby_events) & worker)) {
+        xEventGroupSetBits(sdio_standby_events, worker << SDIO_ACK_SHIFT);
+        xEventGroupWaitBits(sdio_standby_events, worker, pdFALSE, pdTRUE, portMAX_DELAY);
+        xEventGroupClearBits(sdio_standby_events, worker << SDIO_ACK_SHIFT);
+    }
+}
+
+static void sdio_standby_release_workers(void)
+{
+    xEventGroupSetBits(sdio_standby_events, SDIO_WORKERS_ALL);
+    // Don't start another pause while acknowledgements from the old one remain.
+    while (xEventGroupGetBits(sdio_standby_events) & (SDIO_WORKERS_ALL << SDIO_ACK_SHIFT)) {
+        vTaskDelay(1);
+    }
+}
+
+static bool sdio_standby_park(EventBits_t workers)
+{
+    xEventGroupClearBits(sdio_standby_events, workers);
+    // Wake semaphore-blocked consumers so they can reach a safe boundary.
+    // Their loops explicitly tolerate an empty token on abort/resume.
+    if (workers & SDIO_WORKER_TX) g_h.funcs->_h_post_semaphore(sem_to_slave_queue);
+    if (workers & SDIO_WORKER_COPY) g_h.funcs->_h_post_semaphore(sem_double_buf_xfer_data);
+    if (workers & SDIO_WORKER_RX) g_h.funcs->_h_post_semaphore(sem_from_slave_queue);
+    EventBits_t ack = workers << SDIO_ACK_SHIFT;
+    return (xEventGroupWaitBits(sdio_standby_events, ack, pdFALSE, pdTRUE,
+                               pdMS_TO_TICKS(2500)) & ack) == ack;
+}
