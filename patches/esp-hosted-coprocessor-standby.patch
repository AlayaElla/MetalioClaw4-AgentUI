+// Called under SDIO_DRV_LOCK when allocating a complete RX batch failed.
+// Drain the slave FIFO in small transfers so both ends retain the same byte
+// count. Never publish a partial batch or overwrite the other worker's buffer.
+static uint32_t sdio_rx_discard_batch(uint32_t len)
+{
+    static uint8_t scratch[ESP_BLOCK_SIZE] __attribute__((aligned(HOSTED_MEM_ALIGNMENT_64)));
+    uint32_t remaining = len;
+    while (remaining) {
+        uint32_t chunk = remaining < sizeof(scratch) ? remaining : sizeof(scratch);
+#if H_SDIO_RX_BLOCK_ONLY_XFER
+        uint32_t transfer = ESP_BLOCK_SIZE;
+#else
+        uint32_t transfer = chunk;
+#endif
+        int err = g_h.funcs->_h_sdio_read_block(sdio_handle,
+                ESP_SLAVE_CMD53_END_ADDR - remaining, scratch, transfer, ACQUIRE_LOCK);
+        if (err) break;
+        remaining -= chunk;
+    }
+    return len - remaining;
+}
