@@ -0,0 +1,139 @@
+/* Included after the SDIO implementation so no private buffer ownership escapes. */
+static void sdio_standby_drain(void)
+{
+    interface_buffer_handle_t packet;
+    for (int p = 0; p < MAX_PRIORITY_QUEUES; ++p) {
+        while (!g_h.funcs->_h_dequeue_item(to_slave_queue[p], &packet, 0)) {
+            H_FREE_PTR_WITH_FUNC(packet.free_buf_handle, packet.priv_buffer_handle);
+        }
+        while (!g_h.funcs->_h_dequeue_item(from_slave_queue[p], &packet, 0)) {
+            H_FREE_PTR_WITH_FUNC(packet.free_buf_handle, packet.priv_buffer_handle);
+        }
+    }
+    while (!g_h.funcs->_h_get_semaphore(sem_to_slave_queue, 0)) {}
+    while (!g_h.funcs->_h_get_semaphore(sem_from_slave_queue, 0)) {}
+    while (!g_h.funcs->_h_get_semaphore(sem_double_buf_xfer_data, 0)) {}
+    // Retain all buffers/pools/tasks; the next slave has new byte/buffer counters.
+    double_buf.read_index = -1;
+    double_buf.write_index = 0;
+    double_buf.read_data_len = 0;
+    sdio_tx_buf_count = sdio_rx_byte_count = sdio_write_buf_available = 0;
+    wifi_tx_throttling = 0;
+    sdio_start_write_thread = false;
+    serial_ll_reset_partial_rx();
+}
+
+int bus_prepare_coprocessor_wake(void)
+{
+    gpio_pin_t pin = { .port = H_GPIO_PORT_RESET, .pin = H_GPIO_PIN_RESET };
+    if (!sdio_handle || !sdio_standby_events ||
+        esp_hosted_transport_get_reset_config(&pin) != ESP_TRANSPORT_OK ||
+        !GPIO_IS_VALID_OUTPUT_GPIO(pin.pin)) return ESP_ERR_INVALID_STATE;
+    if (!sdio_coprocessor_off || sdio_coprocessor_boot_started) return ESP_OK;
+    // Only release EN. SDIO workers and the public transport gate stay closed
+    // until the normal resume transaction confirms a fresh INIT.
+    esp_err_t err = gpio_hold_dis(pin.pin);
+    if (err != ESP_OK) return err;
+    err = gpio_set_level(pin.pin, H_RESET_VAL_ACTIVE);
+    if (err != ESP_OK) return err;
+    sdio_coprocessor_boot_tick = xTaskGetTickCount();
+    sdio_coprocessor_boot_started = true;
+    ESP_LOGI(TAG, "C5 boot started early; SDIO remains parked");
+    return ESP_OK;
+}
+
+int bus_set_coprocessor_standby(int enabled)
+{
+    gpio_pin_t pin = { .port = H_GPIO_PORT_RESET, .pin = H_GPIO_PIN_RESET };
+    if (!sdio_handle || !sdio_standby_events ||
+        esp_hosted_transport_get_reset_config(&pin) != ESP_TRANSPORT_OK ||
+        !GPIO_IS_VALID_OUTPUT_GPIO(pin.pin)) return ESP_ERR_INVALID_STATE;
+
+    if (enabled) {
+        if (sdio_coprocessor_off) {
+            // An audio wake failure can return to standby after early EN
+            // release. Do not latch EN high and silently leave C5 running.
+            if (sdio_coprocessor_boot_started) {
+                esp_err_t err = gpio_set_level(pin.pin, H_RESET_VAL_INACTIVE);
+                if (err != ESP_OK) return err;
+                sdio_coprocessor_boot_started = false;
+            }
+            return gpio_hold_en(pin.pin);
+        }
+        xSemaphoreTake(sdio_standby_tx_mutex, portMAX_DELAY);
+        sdio_standby_accept_tx = false;
+        xSemaphoreGive(sdio_standby_tx_mutex);
+        // Park upstream first; downstream must still drain any full queue while
+        // its producer finishes. Never delete a task holding an SDMMC mutex.
+        bool parked = sdio_standby_park(SDIO_WORKER_READ | SDIO_WORKER_TX) &&
+                      sdio_standby_park(SDIO_WORKER_COPY) &&
+                      sdio_standby_park(SDIO_WORKER_RX);
+        if (!parked) {
+            sdio_standby_release_workers();
+            xSemaphoreTake(sdio_standby_tx_mutex, portMAX_DELAY);
+            sdio_standby_accept_tx = true;
+            xSemaphoreGive(sdio_standby_tx_mutex);
+            ESP_LOGW(TAG, "C5 standby aborted: transport did not quiesce; EN unchanged");
+            return ESP_ERR_TIMEOUT;
+        }
+        // transport_gpio_reset() finishes at ACTIVE (EN high on this board).
+        // INACTIVE is the level that holds the C5 in reset, not ACTIVE.
+        esp_err_t err = gpio_set_level(pin.pin, H_RESET_VAL_INACTIVE);
+        if (err != ESP_OK) {
+            sdio_standby_release_workers();
+            xSemaphoreTake(sdio_standby_tx_mutex, portMAX_DELAY);
+            sdio_standby_accept_tx = true;
+            xSemaphoreGive(sdio_standby_tx_mutex);
+            return err;
+        }
+        sdio_coprocessor_off = true; // wake must restore even if GPIO hold fails
+        sdio_coprocessor_starting = false;
+        sdio_coprocessor_boot_started = false;
+        set_transport_state(TRANSPORT_INACTIVE);
+        sdio_standby_drain();
+        err = gpio_hold_en(pin.pin);
+        ESP_LOGI(TAG, "C5 held in reset; SDIO workers parked, SD card slot retained (%s)",
+                 esp_err_to_name(err));
+        return err;
+    }
+
+    if (!sdio_coprocessor_off && !sdio_coprocessor_starting) return ESP_OK;
+    // A failed handshake is retryable. Quiesce before giving the C5 another reset.
+    if (sdio_coprocessor_starting) {
+        int err = bus_set_coprocessor_standby(1);
+        if (err != ESP_OK) return err;
+    }
+    esp_err_t err = bus_prepare_coprocessor_wake();
+    if (err != ESP_OK) return err;
+    const TickType_t elapsed = xTaskGetTickCount() - sdio_coprocessor_boot_tick;
+    const TickType_t required = pdMS_TO_TICKS(H_HOST_SDIO_RESET_DELAY_MS);
+    if (elapsed < required) g_h.funcs->_h_msleep((required - elapsed) * portTICK_PERIOD_MS);
+    err = transport_card_init(sdio_handle, 1500);
+    if (err != ESP_OK) {
+        gpio_set_level(pin.pin, H_RESET_VAL_INACTIVE);
+        sdio_coprocessor_boot_started = false;
+        gpio_hold_en(pin.pin);
+        ESP_LOGW(TAG, "C5 card reinit failed; transport remains parked for retry");
+        return err;
+    }
+    sdio_reopen_data_path = true;
+    sdio_coprocessor_off = false;
+    sdio_coprocessor_boot_started = false;
+    sdio_coprocessor_starting = true;
+    set_transport_state(TRANSPORT_RX_ACTIVE);
+    xSemaphoreTake(sdio_standby_tx_mutex, portMAX_DELAY);
+    sdio_standby_accept_tx = true;
+    xSemaphoreGive(sdio_standby_tx_mutex);
+    sdio_standby_release_workers();
+    // Wait for the complete INIT handler, including its reply and rpc_start().
+    for (int attempt = 0; attempt < 400; ++attempt) {
+        if (is_transport_tx_ready() && sdio_start_write_thread) {
+            sdio_coprocessor_starting = false;
+            ESP_LOGI(TAG, "C5 fresh INIT confirmed; transport restored");
+            return ESP_OK;
+        }
+        g_h.funcs->_h_msleep(20);
+    }
+    ESP_LOGW(TAG, "C5 fresh INIT timed out; wake can retry");
+    return ESP_ERR_TIMEOUT;
+}
