+bool WifiStation::SetStandby(bool enabled) {
+    if (enabled) {
+        const bool was_standby = standby_.exchange(true);
+        CancelReconnect();
+        if (!was_standby) RememberConnectedAp();
+        if (timer_handle_ != nullptr) esp_timer_stop(timer_handle_);
+        if (!driver_started_) return true;
+        esp_wifi_scan_stop();
+        const esp_err_t err = esp_wifi_stop();
+        if (err != ESP_OK && err != ESP_ERR_WIFI_NOT_STARTED) {
+            ESP_LOGW(TAG, "Standby stop failed: %s", esp_err_to_name(err));
+            return false; // Retain the gate so a later wake can retry start.
+        }
+        xEventGroupClearBits(event_group_, WIFI_EVENT_CONNECTED);
+        ESP_LOGI(TAG, "WiFi radio stopped for offline standby");
+        return true;
+    }
+    if (!standby_.load()) return true;
+    fast_reconnect_pending_.store(standby_wifi_config_valid_);
+    standby_.store(false); // STA_START must be allowed to start reconnection.
+    if (!driver_started_) return true;
+    const esp_err_t err = esp_wifi_start();
+    if (err != ESP_OK) {
+        standby_.store(true);
+        CancelReconnect();
+        ESP_LOGW(TAG, "Standby restart failed: %s", esp_err_to_name(err));
+        return false;
+    }
+    ESP_LOGI(TAG, "WiFi radio restarted; reconnecting saved network");
+    return true;
+}
+
+bool WifiStation::SetOfflineStandby(bool enabled, const std::function<bool(bool)>& coprocessor) {
+    if (enabled) {
+        // Gate events before stopping/deinitializing the remote WiFi driver.
+        if (!standby_wifi_needs_init_) {
+            if (!SetStandby(true)) return false;
+            if (driver_started_) {
+                const esp_err_t err = esp_wifi_deinit();
+                if (err != ESP_OK) {
+                    ESP_LOGW(TAG, "Offline WiFi deinit failed: %s", esp_err_to_name(err));
+                    return false;
+                }
+                standby_wifi_needs_init_ = true;
+                standby_restore_config_ = true;
+            }
+        }
+        // A failed transport pause leaves the radio stopped; waking retries
+        // recovery, without destroying netif, handlers or saved credentials.
+        return coprocessor(true);
+    }
+    if (!coprocessor(false)) return false;
+    if (standby_restore_config_) {
+        esp_err_t err = ESP_OK;
+        if (standby_wifi_needs_init_) {
+            wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
+            cfg.nvs_enable = false;
+            err = esp_wifi_init(&cfg);
+            if (err == ESP_OK) standby_wifi_needs_init_ = false;
+        }
+        if (err == ESP_OK) err = esp_wifi_set_mode(WIFI_MODE_STA);
+        if (err == ESP_OK) err = esp_wifi_set_ps(power_save_enabled_.load() ? WIFI_PS_MIN_MODEM : WIFI_PS_NONE);
+        if (err != ESP_OK) {
+            ESP_LOGW(TAG, "Offline WiFi restore failed: %s", esp_err_to_name(err));
+            return false;
+        }
+    }
+    if (!SetStandby(false)) return false;
+    if (standby_restore_config_ && max_tx_power_ != 0) {
+        const esp_err_t err = esp_wifi_set_max_tx_power(max_tx_power_);
+        if (err != ESP_OK) ESP_LOGW(TAG, "Restore TX power failed: %s", esp_err_to_name(err));
+    }
+    standby_restore_config_ = false;
+    return true;
 }
 
