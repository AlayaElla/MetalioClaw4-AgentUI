+void WifiStation::CancelReconnect() {
+    ++reconnect_generation_;
+    retry_deadline_us_.store(0);
+    fast_reconnect_pending_.store(false);
+    reconnect_phase_.store(ReconnectPhase::Idle);
+    if (timer_handle_ != nullptr) esp_timer_stop(timer_handle_);
+}
+
+void WifiStation::RememberConnectedAp() {
+    standby_wifi_config_valid_ = false;
+    wifi_ap_record_t ap{};
+    wifi_config_t config{};
+    if (!driver_started_ || !IsConnected() ||
+        esp_wifi_sta_get_ap_info(&ap) != ESP_OK ||
+        esp_wifi_get_config(WIFI_IF_STA, &config) != ESP_OK ||
+        config.sta.ssid[0] == 0 ||
+        memcmp(config.sta.ssid, ap.ssid, sizeof(config.sta.ssid)) != 0) return;
+    // Cache the actually connected AP, not a prior scan candidate. RAM only;
+    // a settings takeover/Stop invalidates this hint and retains saved networks.
+    config.sta.channel = ap.primary;
+    memcpy(config.sta.bssid, ap.bssid, sizeof(config.sta.bssid));
+    config.sta.bssid_set = true;
+    config.sta.scan_method = WIFI_FAST_SCAN;
+    standby_wifi_config_ = config;
+    standby_wifi_config_valid_ = true;
+}
+
+void WifiStation::ArmRetry(int64_t delay_us) {
+    if (standby_.load() || timer_handle_ == nullptr) return;
+    retry_deadline_us_.store(esp_timer_get_time() + delay_us);
+    esp_timer_stop(timer_handle_);
+    esp_timer_start_once(timer_handle_, delay_us);
+}
+
+void WifiStation::BeginScan() {
+    if (standby_.load()) return;
+    fast_reconnect_pending_.store(false);
+    retry_deadline_us_.store(0);
+    if (timer_handle_ != nullptr) esp_timer_stop(timer_handle_);
+    connect_queue_.clear();
+    reconnect_phase_.store(ReconnectPhase::Scanning);
+    const auto err = esp_wifi_scan_start(nullptr, false);
+    if (standby_.load()) return;
+    if (err != ESP_OK) {
+        reconnect_phase_.store(ReconnectPhase::Idle);
+        ArmRetry(1000000);
+        return;
+    }
+    if (on_scan_begin_) on_scan_begin_();
+}
+
+void WifiStation::BeginWakeReconnect() {
+    if (standby_.load() || reconnect_phase_.load() != ReconnectPhase::Idle) return;
+    if (!fast_reconnect_pending_.exchange(false)) {
+        BeginScan();
+        return;
+    }
+    reconnect_phase_.store(ReconnectPhase::FastConnecting);
+    connect_queue_.clear();
+    reconnect_count_ = 0;
+    ESP_LOGI(TAG, "Fast standby reconnect: cached channel=%u, full scan deferred",
+             standby_wifi_config_.sta.channel);
+    if (on_connect_) on_connect_(ssid_);
+    auto err = esp_wifi_set_config(WIFI_IF_STA, &standby_wifi_config_);
+    if (standby_.load()) return;
+    if (err == ESP_OK) err = esp_wifi_connect();
+    if (standby_.load()) return;
+    if (err != ESP_OK) {
+        ESP_LOGW(TAG, "Fast reconnect request failed: %s", esp_err_to_name(err));
+        FallBackToScan(false);
+        return;
+    }
+    ArmRetry(kFastReconnectTimeoutUs);
+}
+
+void WifiStation::FallBackToScan(bool disconnect) {
+    if (standby_.load()) return;
+    ESP_LOGI(TAG, "Fast reconnect fallback: scanning saved networks");
+    if (!disconnect) {
+        BeginScan();
+        return;
+    }
+    // Wait for disconnect acknowledgement before scanning. A delayed
+    // disconnect event must not reconnect the old, BSSID-pinned target.
+    reconnect_phase_.store(ReconnectPhase::Disconnecting);
+    const auto err = esp_wifi_disconnect();
+    if (standby_.load()) return;
+    if (err == ESP_OK) ArmRetry(500000);
+    else BeginScan();
+}
+
+void WifiStation::HandleRetry(uint32_t generation) {
+    if (standby_.load() || generation != reconnect_generation_.load()) return;
+    const int64_t deadline = retry_deadline_us_.load();
+    if (deadline == 0) return;
+    const int64_t remaining = deadline - esp_timer_get_time();
+    if (remaining > 0) { ArmRetry(remaining); return; }
+    retry_deadline_us_.store(0);
+    const auto phase = reconnect_phase_.load();
+    if (phase == ReconnectPhase::FastConnecting) FallBackToScan(true);
+    else if (phase == ReconnectPhase::Idle || phase == ReconnectPhase::Disconnecting) BeginScan();
 }
 
